# 环境配置
.env

# 运行时数据
data/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# 虚拟环境
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 脚本工具
#
# 整个目录忽略（里面多是本地一次性脚本），但**发密钥的工具要留下** ——
# 宣传期给体验者逐个发密钥全靠它，换台机器 clone 下来就没了等于白写。
# 注意：git 不会进入被忽略的目录，所以只写 `!scripts/new_key.py` 是**无效**的，
# 必须先把目录放出来、再逐条排除（下面这三行的顺序不能改）。
scripts/
!scripts/
scripts/*
!scripts/new_key.py

# 项目文档
项目文档/
*.docx
~$*.docx

# Claude Code 本地配置
.claude/
.agents/
skills-lock.json

# 原始素材（大文件）
extension/帧知.png

# codex本地配置
.codex/
# 架构图等文档快照不提交，但保留 images 目录里的图片
docs/*
!docs/images/
# 架构图要随仓库发布 —— README 里直接链接了 HTML，忽略掉它链接在 GitHub 上就是 404。
# 规格 JSON 一并入库，贡献者才能重新生成/迭代这张图。
!docs/framewise-architecture.json
!docs/framewise-architecture.html
# visual-check 的截图与回执是本机跑出来的验收证据，不入库
docs/*.visual-check.*

# 评测运行日志（运行产物，不入库）
evaluation/logs/

# 跑批中间产物：增量落盘的半成品 / 补跑前的手工备份。
# 都不入库 —— partial 每次跑批都会被覆盖，bak 是本地排障用的。
evaluation/*.partial.json
evaluation/*.json.bak*
