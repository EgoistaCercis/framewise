  "cards": [
    {
      "dot": "cyan",
      "title": "核心取舍：轻量视觉",
      "items": [
        "视觉只送「字幕 + 用户暂停的那一帧」，不送整段视频",
        "画面题不输原生多模态：visual_only 相关性 0.872 vs 0.801",
        "成本 ¥0.024/题 vs ¥0.198/题，延迟 15.5s vs 102.7s"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent 主循环",
      "items": [
        "ReAct loop + 流式输出，带迭代上限与兜底回答",
        "工具集 7 个：问答 / 截帧 / 出题 / 笔记；记忆工具 3 个",
        "危险操作走 HITL 确认；工具结果按上下文感知压缩"
      ]
    },
    {
      "dot": "amber",
      "title": "模型网关",
      "items": [
        "统一 OpenAI 协议，兼容任意厂商；function calling + 流式",
        "四路路由：judge > multimodal > smart > default",
        "前缀缓存友好布局；用量统一记账并分视频归集"
      ]
    },
    {
      "dot": "rose",
      "title": "评测体系（离线）",
      "items": [
        "80 题 × 8 个教育视频，5 类问题；字幕带时间戳",
        "LLM-as-judge 走独立裁判模型，避免自评偏差",
        "复用同一个网关，但完全不参与产品链路"
      ]
    }
  ]
