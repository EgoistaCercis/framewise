# DeepSeek API (对话LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动 SiliconFlow API (Embedding)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 阿里云 DashScope API (视觉理解 Qwen VL)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_VL_MODEL=qwen-vl-plus

# ASR 模式: "api" = 硅基流动 SenseVoice (推荐, 快), "local" = faster-whisper (免费, 慢)
ASR_MODE=api

# ffmpeg 可执行文件路径（如果已在PATH中则保持默认）
FFMPEG_PATH=D:/FormatFactory/ffmpeg.exe

# 应用配置
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000
