# ═══════════════════════════════════════════
# 帧知 配置模板
#
# 第一次配置只需要看【一】的三个 API Key ---- 填完就能跑。
# 其余全都有默认值，等真要调的时候再回来改。
#
#   一、必填          聊天模型 / 画面分析模型 / 向量化模型
#   二、对外部署必看  监听地址、访问密钥、每日限额、安全闸
#   三、可选-模型行为 上下文预算、记忆、裁判、多模态（都有默认值）
#   四、可选-语音识别 ASR（没有官方字幕时才用）
#   五、可选-媒体与其他 ffmpeg 路径、切块、上传上限
# ═══════════════════════════════════════════

# ═══════════════════════════════════════════
# 一、必填 ---- 这三组的 API Key 不填，服务跑不起来
# ═══════════════════════════════════════════

# ── Chat / LLM（主模型）────────────────────────
# 示例切换到通义千问：LLM_PROVIDER=qwen, LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_PROVIDER=deepseek
LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your_key_here
LLM_MODEL=deepseek-v4-pro

# 单次生成的最大输出 token（推理模型的 reasoning 也占这里）
LLM_MAX_TOKENS=8192

# 单次调用的**整体**超时（秒）。不是"只连不上"的超时 ——
# 推理模型生成上万 token 很容易吃满，超时会触发重试。
LLM_TIMEOUT=120

# 单个工具的**单次执行**上限（秒）。工具内部可能调模型（截帧的 VL、出题）
# 或拉流下载，都可能长时间挂起；Agent 循环没有别的兜底，
# 一个工具卡死就会占住整轮对话、把用户晾在那里。
AGENT_TOOL_TIMEOUT=180

# ── Vision（画面分析，VL 描述单帧）───────────
VISION_PROVIDER=dashscope
# OpenAI 兼容 endpoint（支持 image_url 多模态）—— 网关走这个
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 旧专有 endpoint，仅保留兼容
VISION_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VISION_API_KEY=your_key_here
VISION_MODEL=qwen-vl-plus
VISION_FORMAT=dashscope_vision

# ── Embedding（向量化）───────────────────────
# 示例切换到 OpenAI：EMBEDDING_PROVIDER=openai, EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=your_key_here
EMBEDDING_MODEL=BAAI/bge-m3

# ═══════════════════════════════════════════
# 二、对外部署必看（只在本机自己用可以整段跳过）
# ═══════════════════════════════════════════

# ── 访问鉴权 ──────────────────────────────────
# 所有 /api/* 请求需带 X-API-Key 头（插件「设置 → 访问密钥」里填一样的值）。
#
# ★ 留空时的行为**按监听地址决定**：
#     只监听 127.0.0.1 / localhost  → 放行（只有本机，本来就安全）
#     监听 0.0.0.0 等对外地址        → **拒绝所有 /api 请求**（503）
#   也就是「想对外提供服务，就必须设一个」——
#   避免忘了配就裸奔在公网上，被扫到的人拿去调 /api/videos/from_url 烧你的 LLM 额度。
#
# 本地自己用（HOST=127.0.0.1）可以留空；部署到服务器请设置一个随机密钥，
# 怎么生成见 README 的「部署到服务器」一节。
API_AUTH_KEY=

# 多人使用：给**每人发一个独立密钥**，格式 `名字:密钥,名字:密钥`（可与上面的单密钥共存）。
# 不建议大家共享一个密钥 —— 那样用量分不出谁、踢人要所有人重配、也没法单独限量。
# 例：API_AUTH_KEYS=alice:xxxxxxxx,bob:yyyyyyyy
#
# ★ 名字有规则，写错会被**丢弃**（表现为那个人一直 401）：只允许数字/字母/
#   下划线/连字符/中文，且 ≤32 字符；两个名字规整后还不能撞车（alice.x 与
#   alice_x 会落到一起）。要连续给多人发密钥时用脚本，别手敲：
#       python scripts/new_key.py 小王 小李           # 只打印
#       python scripts/new_key.py 小王 小李 --append  # 直接写进本文件
API_AUTH_KEYS=

# 每人每日 token 上限（输入+输出，按自然日）。0 = 不限制，超过返回 429。
# ★ 限额比"事后看报表"更重要：等报表里看出异常，额度已经烧完了。
#   拿到密钥的人能调 /api/videos/from_url 让服务器下任意视频（占带宽磁盘，不只是 token）。
#
# ★★ 对外发密钥（体验/试用）时**必须设一个非零值** —— 否则账上没有任何刹车。
# 取值依据（来自本项目 usage.db 的真实统计，deepseek-v4-flash）：
#     · 真实交互的一天 ≈ 5 万 token（实测 5k~50k）
#     · 单次调用的最大值 ≈ 35 万 token（长字幕 + 长回答）
#     · 约 200 万 token ≈ ¥1
#   所以 1,000,000 的含意是：**约 20 个正常使用日**，或"最多每人每天 ¥0.5"。
#   20 个体验者全部跑满 ≈ ¥10/天 —— 这就是最坏情况的上界。
#   嫌紧就调大；但**不要设 0**。
# 用量查看：GET /api/usage/by_caller（本机看全量，远程只看自己）
API_DAILY_TOKEN_LIMIT=1000000

# ── 服务 ─────────────────────────────────────
DATA_DIR=./data
# 笔记保存目录（插件里的「设置」可以改，改完会写回 .env）
# ★ 远程调用者改不了这个（会 403）—— 它等于"把服务器上任意目录变成可写目录"。
#   多人使用时，各人的笔记实际落在 NOTE_DIR/_users/<名字>/ 下。
NOTE_DIR=./data/notes
# 监听地址。0.0.0.0 = 允许局域网/公网访问（部署到服务器时用这个）
HOST=0.0.0.0
PORT=8123

# /docs /redoc /openapi.json 是否暴露。留空 = 按监听地址决定
# （只监听本机时开，对外监听时关 —— 开着等于把全部 API 结构送给扫描器）。
# 远程也想看文档就设 1。
API_DOCS=

# ── SSRF 闸 / 上传上限（对外部署时看）────────────
# 允许服务器**代为访问**的媒体站点（逗号分隔，子域名自动放行）。
# /api/videos/from_url 和字幕下载都是让服务器去 GET 别人给的 URL，
# 不设闸的话持钥者可以拿它探测内网服务或云元数据端点（169.254.169.254）。
#
# ★ hdslb.com 不能漏 —— B 站的字幕 JSON 在 aisubtitle.hdslb.com 上。
#   漏了它整条"字幕拦截→上传"链路会全 400，前端表现为"一直卡在处理字幕"。
#   这份名单漏一个就静默坏一个功能，改完看启动日志里打印的那一行核对。
ALLOWED_MEDIA_HOSTS=bilibili.com,b23.tv,bilibili.tv,hdslb.com,youtube.com,youtu.be,youtube-nocookie.com

# 单次上传文件大小上限（MB）。上传是**唯一**一个请求体完全由调用者控制的入口，
# 原来是一把读进内存 —— 传个超大文件就能把服务打爆（容器没设 memory limit）。
# 超过返回 413。
MAX_UPLOAD_MB=500

# ═══════════════════════════════════════════
# 三、可选 - 模型行为与上下文（都有默认值，不用改）
# ═══════════════════════════════════════════

# ── Chat / LLM - Smart ───────────────────────
# 前端「智能」按钮启用的高阶模型，厂家/endpoint/key 可与 default 不同。
# 未配置 SMART_LLM_API_KEY（或仍是占位符）时，智能按钮自动回落到 default。
SMART_LLM_PROVIDER=deepseek
SMART_LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
SMART_LLM_API_KEY=your_key_here
SMART_LLM_MODEL=deepseek-v4-pro

# ── 上下文预算 ────────────────────────────────
# 模型窗口。**换模型时必须同步改** —— 它同时是各处预算的推导依据。
# 默认 128000 的依据：DeepSeek 官方 API 文档，deepseek-chat 系列上下文为 128K。
MODEL_CONTEXT_WINDOW_TOKENS=128000

# 单次请求**输入**的策略上限。取窗口的一半：给输出和突发留余量，
# 也让"临时换一个 64K 窗口的模型"仍然安全。
# ★ 字幕/历史/记忆/工具预留这四处预算之和不得越过它 ——
#   启动时会自检，超了会打印警告（不改行为，只提醒）。
INPUT_BUDGET_TOKENS=64000

# ── 上下文与记忆 ──────────────────────────────
# 全量字幕注入的阈值。字幕短于它 → 整段注入；超长 → 退回 RAG 检索。
# 依据：实测全量注入对 RAG 质量 12 项胜 9 / 负 1 / 平 2。
# （注意成本口径：输入侧因字幕是稳定前缀、命中缓存而更省，但完整账单下
#  全量每题略贵约 20% —— 回答更长。以完整账单为准。）
# 设为 0 可关闭全量注入，退回纯 RAG。
FULL_CONTEXT_MAX_TOKENS=30000

# 历史对话：条数上限 + 摘要触发阈值（两层闸）
CONTEXT_MAX_MESSAGES=50
# ★ 必须**低于「条数上限能产出的最坏值」（实测 ≈32,900）**，否则摘要永不触发。
CONTEXT_MAX_TOKENS=20000
# 单条工具结果的裁剪长度（低于它不压缩）
TOOL_TRIM_LENGTH=500
# 摘要的目标字数
SUMMARY_TARGET_LENGTH=200

# 检索返回的 chunk 数
RAG_TOP_K=5

# 长期记忆：注入预算 / 学习主题的归档期限 / 攒批兜底的间隔轮数
MEMORY_PROMPT_BUDGET_TOKENS=400
MEMORY_TTL_DAYS=30
MEMORY_BATCH_ROUNDS=5

# ── 评测裁判模型（LLM-as-judge，仅评测用）──────
# 独立配置的意义：裁判与被评模型**同源会有自评偏差**（自己评自己偏松）。
# 不配置则回落到默认 chat 模型并告警（此时必须在评测报告里注明"同源"）。
JUDGE_PROVIDER=
JUDGE_ENDPOINT=
JUDGE_API_KEY=
JUDGE_MODEL=
# 裁判专用超时（秒）。**必须比 LLM_TIMEOUT 大** ——
# 裁判是 12000 max_tokens 的思考型生成，实测 reasoning 就要 4000~6500，
# 单次 2~4 分钟；用产品侧的 120s 会在生成中途打断，
# 而**被打断的那次已经生成并计费了**，只是我们没等。
JUDGE_TIMEOUT=300

# ── 多模态模型（V5 评测用）────────────────────
# 与 VISION_* 的区别：VISION_* 是「描述单帧」的辅助模型（输出文字供主模型消费）；
# MULTIMODAL_* 是「直接把图和问题一起理解」的模型。角色不同，故分开配置。
MULTIMODAL_PROVIDER=
MULTIMODAL_ENDPOINT=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=

# ═══════════════════════════════════════════
# 四、可选 - 语音识别（没有官方字幕时才用得上）
# ═══════════════════════════════════════════

# ── ASR（语音转写）───────────────────────────
# 注意：字幕**官方优先**，没有官方字幕时不会自动跑 ASR，
# 而是等用户在插件里点按钮触发（ASR 要几分钟且消耗额度）。
#
# 模式: "api" = 硅基流动 SenseVoice / "local" = faster-whisper
ASR_MODE=api

# API 文件上传
ASR_PROVIDER=siliconflow
ASR_ENDPOINT=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_API_KEY=your_key_here
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# URL 直传（DashScope Paraformer，可选，比上传文件快）
ASR_URL_PROVIDER=dashscope
ASR_URL_API_KEY=your_key_here

# B 站 Cookie（可选）。**注意：多数情况下不需要它。**
#
# 不配也能跑：代码会自动取一个 buvid3（设备指纹，无需登录），用来绕开
# B 站对机房 IP 的 HTML 风控（不带 Cookie 取网页会 412）。
#
# ★ 它的唯一实际价值是让 **ASR**（下音频）和"自动取标题"在机房服务器上可用。
#   **字幕那条主路径完全不需要它** —— 字幕是 CDN 签名直链，链接自身即凭据
#   （实测：把拦截到的链接发到手机浏览器，没有任何 B 站 Cookie 也能打开）。
#
# ⚠️⚠️ 这是**账号凭据**，代价要清楚：
#   · 代码已做域名隔离（只发给 bilibili.com / hdslb.com / bilivideo.com 等 B 站域），
#     曾经存在的问题是"整个 Cookie 会被发给 youtube.com"—— 那是实测确认过的，
#     现已在 url_service._headers() 里按目标域判断修掉。
#   · 但风险不是零：yt-dlp 抓 B 站时要访问它自己解析出的 CDN，那些域也在放行范围内。
#   · **建议用一个专门的小号**，别填主账号。只填自己的 .env，别提交、别外发。
# 取值：浏览器打开 bilibili.com → F12 → Network → 任一请求 → 复制整条 Cookie
#       （至少要有 SESSDATA 和 buvid3）
BILIBILI_COOKIE=

# 本地 ASR（ASR_MODE=local 时才用）
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ═══════════════════════════════════════════
# 五、可选 - 媒体处理与其他
# ═══════════════════════════════════════════

# ── 媒体处理 ─────────────────────────────────
# ffmpeg 路径（Windows 需完整路径；Linux/Docker 用 "ffmpeg" 即可）
FFMPEG_PATH=D:/FormatFactory/ffmpeg.exe

# 字幕切块（供检索用）
CHUNK_MAX_LENGTH=300
CHUNK_OVERLAP=50

# Hugging Face 镜像（本地 ASR 下载模型用）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENABLE_HF_TRANSFER=0
